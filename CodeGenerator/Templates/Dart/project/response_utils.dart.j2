import 'dart:convert';

import 'package:shelf/shelf.dart';

/// Utility class for creating standardized HTTP responses
class ResponseUtils {
  static const _jsonHeaders = {'Content-Type': 'application/json'};

  /// 200 OK response
  static Response ok(dynamic data) {
    return Response.ok(
      jsonEncode(data),
      headers: _jsonHeaders,
    );
  }

  /// 201 Created response
  static Response created(dynamic data) {
    return Response(
      201,
      body: jsonEncode(data),
      headers: _jsonHeaders,
    );
  }

  /// 204 No Content response
  static Response noContent() {
    return Response(204);
  }

  /// 400 Bad Request response
  static Response badRequest(String message) {
    return Response(
      400,
      body: jsonEncode({
        'error': 'Bad Request',
        'message': message,
      }),
      headers: _jsonHeaders,
    );
  }

  /// 401 Unauthorized response
  static Response unauthorized([String message = 'Unauthorized']) {
    return Response(
      401,
      body: jsonEncode({
        'error': 'Unauthorized',
        'message': message,
      }),
      headers: _jsonHeaders,
    );
  }

  /// 403 Forbidden response
  static Response forbidden([String message = 'Forbidden']) {
    return Response(
      403,
      body: jsonEncode({
        'error': 'Forbidden',
        'message': message,
      }),
      headers: _jsonHeaders,
    );
  }

  /// 404 Not Found response
  static Response notFound(String message) {
    return Response(
      404,
      body: jsonEncode({
        'error': 'Not Found',
        'message': message,
      }),
      headers: _jsonHeaders,
    );
  }

  /// 409 Conflict response
  static Response conflict(String message) {
    return Response(
      409,
      body: jsonEncode({
        'error': 'Conflict',
        'message': message,
      }),
      headers: _jsonHeaders,
    );
  }

  /// 422 Unprocessable Entity response
  static Response unprocessableEntity(String message, [Map<String, dynamic>? errors]) {
    return Response(
      422,
      body: jsonEncode({
        'error': 'Unprocessable Entity',
        'message': message,
        if (errors != null) 'errors': errors,
      }),
      headers: _jsonHeaders,
    );
  }

  /// 500 Internal Server Error response
  static Response internalError([String? message]) {
    return Response(
      500,
      body: jsonEncode({
        'error': 'Internal Server Error',
        'message': message ?? 'An unexpected error occurred',
      }),
      headers: _jsonHeaders,
    );
  }
}
