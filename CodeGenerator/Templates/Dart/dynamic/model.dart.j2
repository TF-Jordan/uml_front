{%- elif attr.relation_kind == 'many_to_one' %}
      '{{ attr.snake_name }}': {{ attr.camel_name }}?.toJson(),
      '{{ attr.snake_name }}_id': {{ attr.camel_name }}Id,
{%- elif attr.is_date %}
      '{{ attr.snake_name }}': {{ attr.camel_name }}{% if attr.nullable %}?{% endif %}.toIso8601String(),
{%- else %}
      '{{ attr.snake_name }}': {{ attr.camel_name }},
{%- endif %}
{%- endfor %}
