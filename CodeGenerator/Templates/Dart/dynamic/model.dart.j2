{%- for attr in attributes %}
{%- if attr.relation_kind == 'one_to_many' or attr.relation_kind == 'many_to_many' %}
      {{ attr.camel_name }}: json['{{ attr.snake_name }}'] != null
          ? (json['{{ attr.snake_name }}'] as List)
              .map((e) => {{ attr.target_class }}.fromJson(e as Map<String, dynamic>))
              .toList()
          : {% if attr.nullable %}null{% else %}[]{% endif %},
{%- elif attr.relation_kind == 'many_to_one' %}
      {{ attr.camel_name }}: json['{{ attr.snake_name }}'] != null
          ? {{ attr.target_class }}.fromJson(json['{{ attr.snake_name }}'] as Map<String, dynamic>)
          : null,
      {{ attr.camel_name }}Id: json['{{ attr.snake_name }}_id'] as int{% if attr.nullable %}?{% endif %},
{%- elif attr.is_date %}
      {{ attr.camel_name }}: json['{{ attr.snake_name }}'] != null
          ? DateTime.parse(json['{{ attr.snake_name }}'] as String)
          : {% if attr.nullable %}null{% else %}DateTime.now(){% endif %},
{%- else %}
      {{ attr.camel_name }}: json['{{ attr.snake_name }}'] as {{ attr.type }}{% if attr.nullable %}?{% endif %},
{%- endif %}
{%- endfor %}
